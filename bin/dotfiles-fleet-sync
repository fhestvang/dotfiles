#!/usr/bin/env bash
# dotfiles-fleet-sync — fan out dotfiles to the fleet after a commit.
#
# Runs sync.sh against each fleet host (full install: --install-packages
# --auto-zsh, the sync.sh default). Self-guards to the source-of-truth machines
# (spark/laptop) so it never fans out from a fleet node, even though .git is
# mirrored to every host by sync.sh's rsync.
#
# Invoked by .git/hooks/post-commit (installed by install.sh), but also runnable
# by hand:  dotfiles-fleet-sync
#
# Env:
#   DOTFILES_FLEET        space-separated host list (default: eigil ingvild dicte)
#   DOTFILES_FANOUT_PUSH  set to 1 to also `git push` origin (default: off)
set -uo pipefail

SCRIPT="$(readlink -f "$0")"
DOTFILES_DIR="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
read -r -a FLEET <<<"${DOTFILES_FLEET:-eigil ingvild dicte}"
LOG_DIR="$HOME/.cache/dotfiles-fleet-sync"
mkdir -p "$LOG_DIR"

# Only the source-of-truth machines fan out; a fleet node returns its own label.
label="$("$DOTFILES_DIR/bin/prompt-host" 2>/dev/null || true)"
case "$label" in
  spark|laptop) ;;
  *) exit 0 ;;
esac

ts="$(date +%Y%m%d-%H%M%S)"
run_log="$LOG_DIR/$ts.log"
ln -sfn "$run_log" "$LOG_DIR/latest.log"

{
  echo "=== fleet sync @ $(date -Is) from $label, HEAD=$(git -C "$DOTFILES_DIR" rev-parse --short HEAD 2>/dev/null) ==="
} >"$run_log"

if [ "${DOTFILES_FANOUT_PUSH:-0}" = "1" ]; then
  if git -C "$DOTFILES_DIR" push >>"$run_log" 2>&1; then
    echo "push: ok" >>"$run_log"
  else
    echo "push: FAILED (continuing)" >>"$run_log"
  fi
fi

pids=()
for h in "${FLEET[@]}"; do
  (
    host_log="$LOG_DIR/$ts.$h.log"
    if "$DOTFILES_DIR/sync.sh" "$h" >"$host_log" 2>&1; then
      echo "ok:   $h"
    else
      echo "FAIL: $h (see $host_log)"
    fi
  ) >>"$run_log" 2>&1 &
  pids+=($!)
done
wait "${pids[@]}" 2>/dev/null || true

echo "=== done @ $(date -Is) ===" >>"$run_log"
